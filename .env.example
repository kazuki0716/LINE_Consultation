# Vercel の Settings > Environment Variables に登録する（ローカルは .env.local にコピー）
ANTHROPIC_API_KEY=sk-ant-...

# 画面に入るための合言葉（おすすめ）。日本語でも可。
ACCESS_CODE=ここに合言葉

# 合言葉なしで誰でも使えるようにする場合のみ true（API利用料に注意）。
# ACCESS_CODE も ALLOW_PUBLIC も無いと、アプリは動きません（誤公開によるAPI利用料の事故を防ぐため）。
# ALLOW_PUBLIC=true

# 任意：使うモデル（既定は claude-sonnet-5-5）
# ANTHROPIC_MODEL=claude-sonnet-5-5
# 任意：1IPあたり1分間の送信上限（既定 12）
# RATE_LIMIT_PER_MIN=12
